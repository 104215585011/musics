PORT=3000
NCM_CLI_COMMAND=ncm-cli
NETEASE_OPENAPI_BASE_URL=https://openapi.music.163.com
NETEASE_APP_ID=your_app_id
NETEASE_ACCESS_TOKEN=optional_user_access_token
NETEASE_ANONYMOUS_ACCESS_TOKEN=
NETEASE_APP_SECRET=your_app_secret
NETEASE_SIGN_TYPE=RSA_SHA256
NETEASE_DEVICE_JSON={"deviceType":"openapi","os":"openapi","appVer":"0.1","channel":"codex","model":"desktop","deviceId":"local-player","brand":"codex","osVer":"1.0.0","clientIp":"127.0.0.1"}
NETEASE_DEFAULT_SONG_IDS=123456,234567,345678
NETEASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
NETEASE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

AICODEE_BASE_URL=https://v2.aicodee.com
AICODEE_MODEL=MiniMax-M2.5-highspeed
AICODEE_API_KEY=
AICODEE_TIMEOUT_MS=20000
